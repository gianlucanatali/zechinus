{
  "name": "zechinus",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encryption as an adapter layer, for apps that already own their backend. See README.md.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./react": "./react/index.ts",
    "./node": "./node/index.ts",
    "./aggregate": "./aggregate/index.ts",
    "./adapters/*": "./adapters/*",
    "./core/*": "./core/*"
  },
  "sideEffects": false,
  "scripts": {
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:react": "vitest run",
    "test:all": "npm run test && npm run test:react",
    "typecheck": "tsc --noEmit",
    "sync-fingerprints": "node scripts/sync-fingerprints.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.101.1",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@tanstack/react-query": "^5.101.1",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
