{
  "name": "zechinus",
  "version": "0.4.2",
  "private": true,
  "description": "End-to-end encryption as an adapter layer, for apps that already own their backend. See README.md.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "dist-cjs",
    "scripts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist-cjs/react/index.cjs"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist-cjs/node/index.cjs"
    },
    "./aggregate": {
      "types": "./dist/aggregate/index.d.ts",
      "import": "./dist/aggregate/index.js",
      "require": "./dist-cjs/aggregate/index.cjs"
    },
    "./adapters/*.ts": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js",
      "require": "./dist-cjs/adapters/*.cjs"
    },
    "./core/*.ts": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "require": "./dist-cjs/core/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && node scripts/rename-cjs-extensions.mjs",
    "prepare": "npm run build",
    "test": "tsx --test 'tests/**/*.test.ts'",
    "test:react": "vitest run",
    "test:all": "npm run test && npm run test:react",
    "typecheck": "tsc --noEmit",
    "sync-fingerprints": "node scripts/sync-fingerprints.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.101.1",
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@tanstack/react-query": "^5.101.1",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
