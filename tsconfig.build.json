{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "dist"
  },
  "include": ["index.ts", "core", "adapters", "react", "aggregate", "node"],
  "exclude": ["node_modules", "tests", "examples", "scripts"]
}
